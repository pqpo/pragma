{
  "name": "@pragma/built-in-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pragma/core": "workspace:*",
    "@pragma/evaluation": "workspace:*",
    "@pragma/interpreter": "workspace:*",
    "@pragma/memory": "workspace:*",
    "@pragma/shared": "workspace:*",
    "zod": "latest"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
