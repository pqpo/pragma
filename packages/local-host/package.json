{
  "name": "@pragma/local-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node-application": {
      "types": "./src/node-application.ts",
      "default": "./dist/node-application.js"
    },
    "./resources": {
      "types": "./src/resources/index.ts",
      "pragma-source": "./src/resources/index.ts",
      "default": "./dist/resources/index.js"
    },
    "./management": {
      "types": "./dist/management.d.ts",
      "default": "./dist/management.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:core": "vitest run test/model-provider-reader.test.ts test/memory-retrieval.test.ts",
    "test:m10": "vitest run test/mission-controller-process.collection.test.ts test/m10-process-runner.test.ts test/m10-performance-runner.test.ts test/mission-controller-process.integration.test.ts",
    "clean": "rm -rf dist",
    "test:business": "vitest run --exclude test/native-keychain-cross-host.test.ts",
    "test:platform": "vitest run test/native-keychain-cross-host.test.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.0",
    "@pragma/built-in-agents": "workspace:*",
    "@pragma/context-filesystem": "workspace:*",
    "@pragma/core": "workspace:*",
    "@pragma/interpreter": "workspace:*",
    "@pragma/shared": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "latest",
    "@pragma/memory": "workspace:*",
    "@pragma/evaluation": "workspace:*",
    "@modelcontextprotocol/client": "2.1.0"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
