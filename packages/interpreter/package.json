{
  "name": "@pragma/interpreter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./src/ast/index.ts",
      "default": "./dist/ast/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:core": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@pragma/core": "workspace:*",
    "@pragma/evaluation": "workspace:*",
    "@pragma/shared": "workspace:*",
    "fflate": "^0.8.2",
    "yaml": "^2.9.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
