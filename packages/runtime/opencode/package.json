{
  "name": "@pragma/runtime-opencode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:core": "vitest run test/governance.test.ts test/skills.test.ts test/stream.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pragma/core": "workspace:*",
    "@pragma/shared": "workspace:*",
    "@opencode-ai/sdk": "1.19.4",
    "@opencode/client": "2.1.3",
    "json5": "2.2.3",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "5.0.5"
  }
}
