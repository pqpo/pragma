{
  "name": "@pragma/runtime-claude-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./availability": {
      "types": "./src/availability.ts",
      "default": "./dist/availability.js"
    },
    "./models": {
      "types": "./src/models.ts",
      "default": "./dist/models.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:core": "vitest run --passWithNoTests test/adapter-contract.test.ts test/models.test.ts test/session.test.ts test/acp-permissions.test.ts test/acp-errors.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.86.0",
    "@agentclientprotocol/sdk": "1.7.0",
    "@pragma/core": "workspace:*",
    "@pragma/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
