{
  "name": "@pragma/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime/process-probe": {
      "types": "./src/runtime/process-probe.ts",
      "default": "./src/runtime/process-probe.ts"
    },
    "./runtime/runtime-adapter": {
      "types": "./src/runtime/runtime-adapter.ts",
      "default": "./src/runtime/runtime-adapter.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:core": "vitest run --passWithNoTests test/resource-id.test.ts test/pragma-paths.test.ts test/token-counter.test.ts test/plugin-manifest.test.ts test/context-binding-metadata.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@pragma/shared": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "gpt-tokenizer": "^3.4.0",
    "gray-matter": "^4.0.3",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "latest"
  }
}
