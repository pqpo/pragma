{
  "name": "@expertmesh/test-script",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/run-expert-agent.ts",
    "start:basic": "tsx src/run-expert-agent.ts",
    "start:workspace-documents": "tsx src/run-workspace-document-agent.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@expertmesh/agent-core": "workspace:*",
    "@expertmesh/agent-runtime": "workspace:*",
    "dotenv": "latest"
  },
  "devDependencies": {
    "@expertmesh/tsconfig": "workspace:*",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
