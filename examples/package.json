{
  "name": "@pragma/examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx",
    "example:expert-chat": "tsx src/experts/getting-started/console-chat.ts",
    "example:runtime-codex": "tsx src/runtimes/codex/console-chat.ts",
    "example:runtime-claude-code": "tsx src/runtimes/claude-code/console-chat.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src plugins test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pragma/core": "workspace:*",
    "@pragma/plugin-repo-manager": "workspace:*",
    "@pragma/plugin-memory": "workspace:*",
    "@pragma/runtime-claude-code": "workspace:*",
    "@pragma/runtime-codex": "workspace:*",
    "@pragma/runtime-pi": "workspace:*",
    "cac": "^7.0.0",
    "dotenv": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
