{
  "name": "@expertmesh/examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm start:basic",
    "start:basic": "tsx src/run-expert-agent.ts",
    "start:approval": "tsx src/run-tool-approval-example.ts",
    "start:code-repositories": "tsx src/plugins/run-code-repository-manager-plugin.ts",
    "start:workspace-context": "tsx src/run-workspace-context-agent.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@expertmesh/agent-core": "workspace:*",
    "@expertmesh/agent-runtime": "workspace:*",
    "cac": "^7.0.0",
    "dotenv": "latest"
  },
  "devDependencies": {
    "@expertmesh/tsconfig": "workspace:*",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
