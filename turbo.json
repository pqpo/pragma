{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "out/**",
        ".plugin-bundles/**",
        ".packaging/cli-metafiles.json",
        ".release/package/**",
        ".release/*.metafile.json"
      ],
      "env": ["PRAGMA_BUILD_MINIFY"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:core": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@pragma/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "out/**",
        ".plugin-bundles/**",
        ".packaging/cli-metafiles.json",
        ".release/package/**",
        ".release/*.metafile.json"
      ],
      "env": ["PRAGMA_BUILD_MINIFY", "PRAGMA_SOURCE_COMMIT", "PRAGMA_DISTRIBUTION_DIGEST"],
      "cache": false
    },
    "@pqpo/pragma#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "out/**",
        ".plugin-bundles/**",
        ".packaging/cli-metafiles.json",
        ".release/package/**",
        ".release/*.metafile.json"
      ],
      "env": ["PRAGMA_DISTRIBUTION_DIGEST"]
    }
  },
  "globalDependencies": [
    "scripts/build-artifact.mjs",
    "apps/cli/scripts/build-bundles.mjs",
    "packages/tsconfig/*.json",
    "scripts/build.mjs",
    "scripts/distribution.mjs",
    "packages/shared/src/distribution.ts"
  ],
  "globalPassThroughEnv": [
    "GOMAXPROCS",
    "PRAGMA_LOG_LEVEL",
    "CI",
    "PRAGMA_DISTRIBUTION_CONFIG",
    "PRAGMA_DISTRIBUTION_DIGEST"
  ]
}
