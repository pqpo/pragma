{
  "name": "@pqpo/pragma",
  "version": "0.1.0-next.29",
  "description": "Pragma command-line interface",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "pragma": "./dist/pragma.js"
  },
  "exports": {},
  "os": [
    "darwin",
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretypecheck": "pnpm exec turbo run build --concurrency=2 --filter=\"@pqpo/pragma...\"",
    "build": "node scripts/build-package.mjs",
    "package:pack": "node scripts/pack-package.mjs",
    "audit:pack": "node scripts/package-audit.mjs",
    "release:reports": "node scripts/release-reports.mjs",
    "m10:doctor:evidence": "node scripts/m10-doctor-evidence.mjs",
    "ci:smoke": "node scripts/smoke-package.mjs",
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:shared-kernel && pnpm test:adapters:prepared",
    "clean": "rm -rf dist .release",
    "test:shared-kernel": "pnpm exec turbo run build --concurrency=2 --filter=\"@pqpo/pragma...\" && node ../../scripts/build-artifact.mjs create cli && pnpm --filter @pragma/core exec vitest run test/file-lock.test.ts && pnpm --filter @pragma/local-host test:business",
    "test:adapters": "pnpm exec turbo run build --concurrency=2 --filter=\"@pqpo/pragma...\" && pnpm test:adapters:prepared",
    "test:adapters:prepared": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@pragma/local-host": "workspace:*",
    "@pragma/runtime-antigravity": "workspace:*",
    "@pragma/runtime-claude-code": "workspace:*",
    "@pragma/runtime-codex": "workspace:*",
    "@pragma/runtime-opencode": "workspace:*",
    "@pragma/runtime-pi": "workspace:*",
    "@pragma/runtime-qodercli": "workspace:*",
    "@pragma/shared": "workspace:*",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "typescript": "latest",
    "vitest": "latest"
  }
}
