{
  "name": "@pragma/desktop",
  "version": "0.2.49",
  "private": true,
  "type": "module",
  "productName": "Pragma",
  "description": "Desktop local Agent bridge for Pragma.",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare:electron": "install-electron",
    "prepare:plugins": "node ./scripts/package-built-in-plugins.mjs",
    "predev": "pnpm exec turbo run build --filter=\"@pragma/desktop^...\" && pnpm run prepare:electron && pnpm run prepare:plugins",
    "dev": "electron-vite dev --watch",
    "prebuild": "pnpm --filter \"@pragma/desktop^...\" build && pnpm run prepare:plugins",
    "build": "electron-vite build && pnpm run verify:styles && pnpm run verify:main && pnpm run verify:preload && pnpm run verify:storage-worker",
    "benchmark:composer": "node ./scripts/benchmark-mission-composer.mjs",
    "benchmark:mission-projection": "node --expose-gc ./scripts/benchmark-mission-projection.mjs",
    "benchmark:mission-stream": "node ./scripts/benchmark-mission-stream.mjs",
    "benchmark:mission-stream-ui": "node ./scripts/benchmark-mission-stream-ui.mjs",
    "verify:storage-worker": "node ./scripts/verify-storage-worker.mjs",
    "verify:main": "node ./scripts/verify-main-bundle.mjs",
    "verify:preload": "node ./scripts/verify-preload-bundle.mjs",
    "verify:styles": "node ./scripts/verify-renderer-styles.mjs",
    "package:dir": "node ./scripts/package-desktop.mjs --dir",
    "dist": "node ./scripts/package-desktop.mjs --publish never",
    "dist:mac": "node ./scripts/package-desktop.mjs --mac --x64 --arm64 --publish never",
    "dist:mac:arm64": "node ./scripts/package-desktop.mjs --mac --arm64 --publish never",
    "dist:mac:x64": "node ./scripts/package-desktop.mjs --mac --x64 --publish never",
    "dist:win": "node ./scripts/package-desktop.mjs --win --x64 --publish never",
    "dist:win:x64": "node ./scripts/package-desktop.mjs --win --x64 --publish never",
    "dist:clean": "node ./scripts/package-desktop.mjs --clean-only",
    "release:desktop": "node ./scripts/release-desktop.mjs",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter \"@pragma/desktop^...\" build",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "pnpm run test:packaging && pnpm run test:claude-worker && vitest run --passWithNoTests",
    "test:core": "pnpm run test:packaging && vitest run --passWithNoTests src/main/bootstrap/application-identity.test.ts src/main/bootstrap/startup-sequence.test.ts",
    "clean": "rm -rf out dist .plugin-bundles",
    "test:packaging": "node --test ./scripts/audit-packaged-app.test.mjs",
    "test:claude-worker": "node --test ./scripts/claude-worker-boundary.test.mjs",
    "test:mission-chat": "vitest run src/test/mission-queued-chat-refresh.test.tsx src/renderer/src/pages/missions/mission-conversation-model.test.ts && vitest run src/main/features/missions/mission-runner.test.ts -t \"streams every queued turn|keeps the captured live answer|projects an already-finished queued turn|projects oversized replies\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dagrejs/dagre": "^3.1.1",
    "@lobehub/icons-static-svg": "1.95.1",
    "@napi-rs/keyring": "1.3.0",
    "@phosphor-icons/react": "latest",
    "@tanstack/react-virtual": "^3.13.18",
    "@pragma/core": "workspace:*",
    "@pragma/context-filesystem": "workspace:*",
    "@pragma/interpreter": "workspace:*",
    "@pragma/local-host": "workspace:*",
    "@pragma/memory": "workspace:*",
    "@pragma/runtime-antigravity": "workspace:*",
    "@pragma/runtime-claude-code": "workspace:*",
    "@pragma/runtime-codex": "workspace:*",
    "@pragma/runtime-opencode": "workspace:*",
    "@pragma/runtime-pi": "workspace:*",
    "@pragma/runtime-qodercli": "workspace:*",
    "@pragma/shared": "workspace:*",
    "@pragma/built-in-agents": "workspace:*",
    "@pragma/evaluation": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "croner": "^10.0.1",
    "fflate": "^0.8.2",
    "i18next": "^26.4.2",
    "jiti": "2.7.0",
    "marked": "18.0.14",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.15",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1",
    "zod": "latest"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard-darwin-arm64": "0.3.9",
    "@mariozechner/clipboard-darwin-x64": "0.3.9",
    "@mariozechner/clipboard-win32-x64-msvc": "0.3.9"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "electron-vite": "latest",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  }
}
