{
  "name": "@pragma/desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "productName": "Pragma",
  "description": "Desktop local Agent bridge for Pragma.",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare:electron": "install-electron",
    "prepare:plugins": "node ./scripts/package-built-in-plugins.mjs",
    "predev": "pnpm run prepare:electron && pnpm run prepare:plugins",
    "dev": "electron-vite dev --watch",
    "prebuild": "pnpm run prepare:plugins",
    "build": "electron-vite build && pnpm run verify:preload",
    "verify:preload": "node ./scripts/verify-preload-bundle.mjs",
    "package:dir": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:mac:arm64": "pnpm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "pnpm run build && electron-builder --mac --x64 --publish never",
    "dist:win": "pnpm run build && electron-builder --win --x64 --publish never",
    "dist:win:x64": "pnpm run build && electron-builder --win --x64 --publish never",
    "lint": "eslint .",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf out dist .plugin-bundles"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "@phosphor-icons/react": "latest",
    "@pragma/core": "workspace:*",
    "@pragma/context-filesystem": "workspace:*",
    "@pragma/interpreter": "workspace:*",
    "@pragma/memory": "workspace:*",
    "@pragma/mission-board": "workspace:*",
    "@pragma/runtime-claude-code": "workspace:*",
    "@pragma/runtime-codex": "workspace:*",
    "@pragma/runtime-pi": "workspace:*",
    "@pragma/runtime-qodercli": "workspace:*",
    "@pragma/shared": "workspace:*",
    "@pragma/default-agent": "workspace:*",
    "@pragma/evaluation": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "croner": "^10.0.1",
    "fflate": "^0.8.2",
    "i18next": "^26.3.6",
    "marked": "18.0.7",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.11",
    "yaml": "^2.9.0",
    "zod": "latest"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard-darwin-arm64": "0.3.9",
    "@mariozechner/clipboard-darwin-x64": "0.3.9",
    "@mariozechner/clipboard-win32-x64-msvc": "0.3.9"
  },
  "devDependencies": {
    "@pragma/tsconfig": "workspace:*",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "electron-vite": "latest",
    "esbuild": "^0.28.1",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  }
}
