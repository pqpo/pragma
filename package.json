{
  "name": "pragma",
  "description": "Make AI-native ways of working reusable and help more people become AI super individuals.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/pqpo/pragma#readme",
  "bugs": {
    "url": "https://github.com/pqpo/pragma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pqpo/pragma.git"
  },
  "keywords": [
    "ai-agents",
    "agent-runtime",
    "multi-agent",
    "orchestration",
    "mcp",
    "typescript"
  ],
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:core",
    "test:core": "turbo run test:core",
    "test:all": "turbo run test",
    "runtime:probe": "pnpm --filter @pragma/examples runtime:probe --",
    "runtime:features:generate": "node ./packages/core/scripts/generate-runtime-feature-checklist.mjs",
    "runtime:features:check": "node ./packages/core/scripts/generate-runtime-feature-checklist.mjs --check",
    "dsl:versions:check": "node ./packages/interpreter/scripts/check-pragma-api-version-literals.mjs",
    "check": "pnpm runtime:features:check && pnpm dsl:versions:check && pnpm lint && pnpm typecheck && pnpm test:core",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "3.9.6",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@qoder-ai/qoder-agent-sdk",
      "esbuild",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "typescript": "6.0.3",
      "eslint": "10.9.1",
      "typescript-eslint": "8.68.0",
      "turbo": "2.10.12",
      "@types/node": "26.1.0",
      "tsx": "4.23.12",
      "electron": "43.2.0"
    }
  }
}
