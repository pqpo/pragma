{
  "name": "pragma",
  "description": "A runtime-neutral platform for composing models, agent harnesses, experts, and flows.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/pqpo/pragma#readme",
  "bugs": {
    "url": "https://github.com/pqpo/pragma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pqpo/pragma.git"
  },
  "keywords": [
    "ai-agents",
    "agent-runtime",
    "multi-agent",
    "orchestration",
    "mcp",
    "typescript"
  ],
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "3.8.5",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3",
      "eslint": "10.6.0",
      "typescript-eslint": "8.63.0",
      "turbo": "2.10.4",
      "@types/node": "26.1.0",
      "tsx": "4.23.0",
      "electron": "43.0.0"
    }
  }
}
