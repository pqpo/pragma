{
  "schemaVersion": "pragma.plugin/v2",
  "id": "repo-manager",
  "name": "Repo Manager",
  "description": "Registers configured Git repositories as Agent context and prepares Git authentication before runtime sessions start.",
  "version": "0.0.0",
  "tags": ["git", "repository", "workspace"],
  "runtime": {
    "type": "expert-agent-plugin",
    "entry": "./dist/index.js",
    "trust": "trusted-host"
  },
  "capabilities": [
    {
      "type": "context",
      "name": "code-repositories.md",
      "description": "Exposes configured repository metadata to the Agent context system."
    },
    {
      "type": "hook",
      "name": "beforeSessionCreate",
      "description": "Checks Git CLI availability and prepares session-level Git authentication environment."
    }
  ],
  "configuration": {
    "type": "object",
    "properties": {
      "contextInjection": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "description": "Controls when repository context is exposed to the model.",
            "enum": ["manual", "model_decision", "always_on"],
            "default": "manual"
          }
        },
        "additionalProperties": false
      },
      "repositories": {
        "type": "array",
        "description": "Configured Git repositories. When omitted, the plugin reads host context repositories.json if present.",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "cloneUrl": { "type": "string", "minLength": 1 },
            "defaultBranch": { "type": "string", "minLength": 1 },
            "provider": {
              "type": "string",
              "enum": ["github", "gitlab", "bitbucket", "generic"],
              "default": "generic"
            },
            "description": { "type": "string", "minLength": 1 },
            "allowedBranches": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "shallowClone": { "type": "boolean", "default": true }
          },
          "required": ["id", "name", "cloneUrl", "defaultBranch"],
          "additionalProperties": false
        }
      },
      "auth": {
        "type": "object",
        "properties": {
          "strategy": {
            "type": "string",
            "enum": ["none", "token", "ssh", "credential_helper"],
            "default": "none"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "Resolved Git token.",
            "x-pragma-secret": true
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "default": "x-access-token"
          },
          "privateKey": {
            "type": "string",
            "minLength": 1,
            "description": "Resolved SSH private key.",
            "x-pragma-secret": true
          },
          "knownHosts": { "type": "string", "minLength": 1 },
          "helper": { "type": "string", "minLength": 1 }
        },
        "required": ["strategy"],
        "allOf": [
          {
            "if": { "properties": { "strategy": { "const": "token" } } },
            "then": { "required": ["token"] }
          },
          {
            "if": { "properties": { "strategy": { "const": "ssh" } } },
            "then": { "required": ["privateKey"] }
          },
          {
            "if": { "properties": { "strategy": { "const": "credential_helper" } } },
            "then": { "required": ["helper"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "permissions": {
    "filesystem": ["workspace:read", "workspace:write"],
    "shell": ["git"],
    "network": ["configured git remotes"],
    "environment": ["git session variables"]
  }
}
