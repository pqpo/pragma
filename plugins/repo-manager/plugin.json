{
  "schemaVersion": "pragma.plugin/v2",
  "id": "repo-manager",
  "name": "Repo Manager",
  "description": "Initializes isolated Git session configuration and authentication for Agent runtimes.",
  "version": "0.0.0",
  "tags": ["git", "authentication", "configuration"],
  "runtime": {
    "type": "expert-agent-plugin",
    "entry": "./dist/index.js",
    "trust": "trusted-host"
  },
  "capabilities": [
    {
      "type": "hook",
      "name": "beforeSessionCreate",
      "description": "Checks Git CLI availability and prepares session-level Git authentication environment."
    }
  ],
  "configuration": {
    "type": "object",
    "properties": {
      "auth": {
        "type": "object",
        "properties": {
          "strategy": {
            "type": "string",
            "enum": ["none", "token", "ssh", "credential_helper"],
            "default": "none"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "Resolved Git token.",
            "x-pragma-secret": true
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "default": "x-access-token"
          },
          "privateKey": {
            "type": "string",
            "minLength": 1,
            "description": "Resolved SSH private key.",
            "x-pragma-secret": true
          },
          "knownHosts": {
            "type": "string",
            "minLength": 1,
            "description": "Pinned SSH known_hosts entries. When omitted, the session uses accept-new with a temporary known_hosts file."
          },
          "helper": { "type": "string", "minLength": 1 }
        },
        "required": ["strategy"],
        "allOf": [
          {
            "if": { "properties": { "strategy": { "const": "token" } } },
            "then": { "required": ["token"] }
          },
          {
            "if": { "properties": { "strategy": { "const": "ssh" } } },
            "then": { "required": ["privateKey"] }
          },
          {
            "if": { "properties": { "strategy": { "const": "credential_helper" } } },
            "then": { "required": ["helper"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "permissions": {
    "filesystem": ["temporary Git authentication and config files"],
    "shell": ["git"],
    "network": [],
    "environment": ["git session variables"]
  }
}
