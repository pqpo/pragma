{
  "schemaVersion": "pragma.plugin/v2",
  "id": "memory",
  "name": "Memory",
  "description": "Registers task memory tools plus evidence-based experience, fact, and skill memory distillation with unified memory context.",
  "version": "0.0.0",
  "tags": ["memory", "context", "skill", "task", "experience", "fact"],
  "runtime": {
    "type": "expert-agent-plugin",
    "entry": "./dist/index.js",
    "trust": "trusted-host"
  },
  "capabilities": [
    {
      "type": "memory",
      "name": "task-memory",
      "description": "Registers the task memory store and task memory tools."
    },
    {
      "type": "memory",
      "name": "skill-memory",
      "description": "Registers the skill memory store and skill distillation pipeline."
    },
    {
      "type": "memory",
      "name": "experience-memory",
      "description": "Registers the experience memory view store for distilled experience records."
    },
    {
      "type": "memory",
      "name": "fact-memory",
      "description": "Registers the fact memory view store for distilled fact records."
    },
    {
      "type": "context",
      "name": "memory",
      "description": "Exposes unified memory audit files as agent context."
    },
    {
      "type": "tool",
      "name": "task-memory-tools",
      "description": "Injects task memory tools into the agent tool set."
    },
    {
      "type": "memory",
      "name": "evidence-distillation",
      "description": "Captures runtime evidence and distills experience, fact, and skill memory asynchronously."
    }
  ],
  "configuration": {
    "type": "object",
    "properties": {
      "task": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "rootDir": { "type": "string", "minLength": 1 },
          "filePath": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "experience": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "filePath": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "fact": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "filePath": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "skill": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "useMemories": { "type": "boolean", "default": true },
          "generateMemories": { "type": "boolean", "default": true },
          "disableOnExternalContext": { "type": "boolean", "default": true },
          "minRunOutputChars": { "type": "number", "minimum": 0, "default": 0 },
          "summaryMaxBytes": { "type": "number", "minimum": 1, "default": 8192 },
          "maxOutputExcerptChars": { "type": "number", "minimum": 1, "default": 1200 },
          "maxToolExcerptChars": { "type": "number", "minimum": 1, "default": 400 },
          "memoryRoot": { "type": "string", "minLength": 1, "default": ".pragma/agent/memory" }
        },
        "additionalProperties": false
      },
      "summary": {
        "type": "object",
        "properties": {
          "maxBytes": { "type": "number", "minimum": 1, "default": 8192 },
          "perRecordMaxChars": { "type": "number", "minimum": 1, "default": 220 },
          "maxTaskItems": { "type": "number", "minimum": 0, "default": 5 },
          "maxFactItems": { "type": "number", "minimum": 0, "default": 6 },
          "maxSkillItems": { "type": "number", "minimum": 0, "default": 5 },
          "maxExperienceItems": { "type": "number", "minimum": 0, "default": 2 }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "permissions": {
    "filesystem": ["pragma-home:read", "pragma-home:write"],
    "shell": [],
    "network": [],
    "environment": []
  }
}
